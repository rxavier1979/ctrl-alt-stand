<Window x:Class="CtrlAltStand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ctrl+Alt+Stand" Icon="app.ico"
        Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="{StaticResource AppFont}" TextOptions.TextFormattingMode="Ideal"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Title-bar window control button -->
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22A3B1C6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF43F5E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain memory chip (1 / 2 / Defaults) -->
        <Style x:Key="ChipPlainButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" BorderThickness="1"
                                BorderBrush="{StaticResource StrokeBrush}"
                                Background="{StaticResource Surface2Brush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF22344F" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF3A557D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root card (rounded, with soft shadow). Margin leaves room for the shadow.
         RootScale is set in code-behind to shrink the window if it exceeds the screen. -->
    <Border x:Name="RootCard" CornerRadius="22" Margin="16" BorderThickness="1"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            BorderBrush="{StaticResource StrokeSoftBrush}">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0F172A" Offset="0" />
                <GradientStop Color="#FF0A0F1C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="14" Direction="270" Opacity="0.7" Color="Black" />
        </Border.Effect>

        <Grid>
            <!-- Ambient accent wash (behind content; recolored per phase) -->
            <Rectangle x:Name="Wash" RadiusX="22" RadiusY="22" IsHitTestVisible="False" Opacity="0.5" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0" CornerRadius="22,22,0,0" Background="#08FFFFFF"
                        BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid Margin="14,11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="BrandMark" Width="26" Height="26" CornerRadius="8"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="&#8593;" FontSize="15" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Ctrl+Alt+Stand" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <!-- Version, so which build is running is answerable at a glance. Set in code. -->
                        <TextBlock Grid.Column="2" x:Name="VersionText" Foreground="{StaticResource TextFaintBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,2,0,0" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Content="&#8211;" Click="Minimize_Click" />
                            <Button Style="{StaticResource CloseButton}" Content="&#10005;" Click="Close_Click" Margin="4,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="20,16,20,16">

                    <!-- Header: kicker + divider + tagline -->
                    <Grid Margin="0,2,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ON THE CLOCK" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                        <Border Grid.Column="1" Height="1" Margin="9,0" VerticalAlignment="Center"
                                Background="{StaticResource StrokeSoftBrush}" />
                        <TextBlock Grid.Column="2" Text="Routine starts when you do" FontSize="12.5"
                                   Foreground="{StaticResource TextDimBrush}" />
                    </Grid>

                    <!-- Hero: ring + timer -->
                    <Grid Width="214" Height="214" HorizontalAlignment="Center">
                        <Ellipse Width="190" Height="190" StrokeThickness="12"
                                 Stroke="{StaticResource RingTrackBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Path x:Name="RingProgress" StrokeThickness="12"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource AccentBrush}">
                            <Path.Effect>
                                <DropShadowEffect x:Name="RingGlow" BlurRadius="12" ShadowDepth="0"
                                                  Color="#FF10B981" Opacity="0.9" />
                            </Path.Effect>
                        </Path>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="PhaseName" Text="STAND" HorizontalAlignment="Center"
                                       FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="-2" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="TimerText" Text="20:00" HorizontalAlignment="Center"
                                       FontSize="52" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                       Margin="0,2" />
                            <TextBlock x:Name="NextText" Text="Next · Move 3m" HorizontalAlignment="Center"
                                       FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Status pill -->
                    <Border x:Name="StatusPill" HorizontalAlignment="Center" Margin="0,14,0,0"
                            CornerRadius="999" BorderThickness="1" Padding="14,6"
                            Background="#1FA3B1C6" BorderBrush="{StaticResource StrokeBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{StaticResource TextFaintBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusText" Text="PAUSED · PRESS START" FontSize="11"
                                       FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Controls -->
                    <Grid Margin="0,18,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="StartButton" Style="{StaticResource PrimaryButton}"
                                Content="Start" Height="46" Margin="0,0,5,0" Click="Start_Click" />
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Skip"
                                Height="46" Margin="5,0,5,0" Click="Skip_Click" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Reset"
                                Height="46" Margin="5,0,0,0" Click="Reset_Click" />
                    </Grid>

                    <!-- Schedule card -->
                    <Border CornerRadius="16" BorderThickness="1" Padding="16"
                            BorderBrush="{StaticResource StrokeSoftBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF16223A" Offset="0" />
                                <GradientStop Color="#FF0F172A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>

                            <!-- Section label -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SCHEDULE" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextFaintBrush}" />
                                <Border Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="{StaticResource StrokeSoftBrush}" />
                            </Grid>

                            <!-- Steppers -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- SIT -->
                                <Border Grid.Column="0" Margin="0,0,5,0" CornerRadius="12" BorderThickness="1"
                                        Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}">
                                    <StackPanel>
                                        <Border Height="3" CornerRadius="11,11,0,0" Background="{StaticResource SitBrush}" />
                                        <TextBlock Text="SIT" HorizontalAlignment="Center" Margin="0,8,0,6"
                                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource SitBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <RepeatButton Style="{StaticResource StepButton}" Content="&#8722;" Click="SitMinus_Click" />
                                            <TextBlock x:Name="SitValue" Text="30" Width="40" TextAlignment="Center"
                                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                            <RepeatButton Style="{StaticResource StepButton}" Content="+" Click="SitPlus_Click" />
                                        </StackPanel>
                                        <TextBlock Text="minutes" HorizontalAlignment="Center" Margin="0,4,0,10"
                                                   FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- STAND -->
                                <Border Grid.Column="1" Margin="5,0,5,0" CornerRadius="12" BorderThickness="1"
                                        Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}">
                                    <StackPanel>
                                        <Border Height="3" CornerRadius="11,11,0,0" Background="{StaticResource StandBrush}" />
                                        <TextBlock Text="STAND" HorizontalAlignment="Center" Margin="0,8,0,6"
                                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource StandBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <RepeatButton Style="{StaticResource StepButton}" Content="&#8722;" Click="StandMinus_Click" />
                                            <TextBlock x:Name="StandValue" Text="20" Width="40" TextAlignment="Center"
                                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                            <RepeatButton Style="{StaticResource StepButton}" Content="+" Click="StandPlus_Click" />
                                        </StackPanel>
                                        <TextBlock Text="minutes" HorizontalAlignment="Center" Margin="0,4,0,10"
                                                   FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- MOVE -->
                                <Border Grid.Column="2" x:Name="MoveTile" Margin="5,0,0,0" CornerRadius="12" BorderThickness="1"
                                        Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource StrokeSoftBrush}">
                                    <StackPanel>
                                        <Border Height="3" CornerRadius="11,11,0,0" Background="{StaticResource MoveBrush}" />
                                        <TextBlock Text="MOVE" HorizontalAlignment="Center" Margin="0,8,0,6"
                                                   FontSize="10" FontWeight="Bold" Foreground="{StaticResource MoveBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <RepeatButton Style="{StaticResource StepButton}" Content="&#8722;" Click="MoveMinus_Click" />
                                            <TextBlock x:Name="MoveValue" Text="3" Width="40" TextAlignment="Center"
                                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                            <RepeatButton Style="{StaticResource StepButton}" Content="+" Click="MovePlus_Click" />
                                        </StackPanel>
                                        <TextBlock Text="minutes" HorizontalAlignment="Center" Margin="0,4,0,10"
                                                   FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Rows -->
                            <StackPanel Margin="0,12,0,0">
                                <!-- Movement break -->
                                <Grid Margin="2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Movement break" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Adds a short Move phase after Stand" FontSize="11"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" x:Name="MoveSwitch" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="Setting_Toggled" Unchecked="Setting_Toggled" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

                                <!-- Start with -->
                                <Grid Margin="2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Start with" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Which phase each work session opens on" FontSize="11"
                                                   Foreground="{StaticResource TextFaintBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="10" Padding="3"
                                            BorderThickness="1" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource StrokeBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="SitSeg" GroupName="StartWith" Style="{StaticResource SegButton}"
                                                         Content="Sit" Checked="Setting_Toggled" />
                                            <RadioButton x:Name="StandSeg" GroupName="StartWith" Style="{StaticResource SegButton}"
                                                         Content="Stand" Checked="Setting_Toggled" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

                                <!-- Sound -->
                                <Grid Margin="2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sound" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" />
                                    <ToggleButton Grid.Column="1" x:Name="SoundSwitch" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="Setting_Toggled" Unchecked="Setting_Toggled" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource StrokeSoftBrush}" />

                                <!-- Always on top -->
                                <Grid Margin="2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Always on top" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextBrush}" />
                                    <ToggleButton Grid.Column="1" x:Name="TopSwitch" Style="{StaticResource Switch}"
                                                  VerticalAlignment="Center" Checked="Setting_Toggled" Unchecked="Setting_Toggled" />
                                </Grid>
                            </StackPanel>

                            <!-- Memory -->
                            <Border Height="1" Background="{StaticResource StrokeSoftBrush}" Margin="0,14,0,0" />
                            <TextBlock Text="MEMORY" FontSize="11" FontWeight="Bold" Margin="0,12,0,9"
                                       Foreground="{StaticResource TextFaintBrush}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="0.7*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="SetChip" Style="{StaticResource ChipPlainButton}"
                                        Content="Set" Margin="0,0,4,0" Click="Set_Click" />
                                <Button Grid.Column="1" Style="{StaticResource ChipPlainButton}" Content="1"
                                        Margin="4,0,4,0" Click="Profile1_Click" />
                                <Button Grid.Column="2" Style="{StaticResource ChipPlainButton}" Content="2"
                                        Margin="4,0,4,0" Click="Profile2_Click" />
                                <Button Grid.Column="3" Style="{StaticResource ChipPlainButton}" Content="Defaults"
                                        Margin="4,0,0,0" Click="Defaults_Click" />
                            </Grid>
                            <TextBlock x:Name="MemHint" Text="Set, then 1 or 2 to save · 1 or 2 to load"
                                       FontSize="11" TextAlignment="Right" Margin="0,9,0,0"
                                       Foreground="{StaticResource TextFaintBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Footer -->
                    <TextBlock Text="⚡ Movement helps circulation more than standing still."
                               HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="11.5"
                               Foreground="{StaticResource TextFaintBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
