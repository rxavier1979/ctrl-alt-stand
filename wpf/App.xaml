<Application x:Class="CtrlAltStand.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ===== Palette (Refined Dark) ===== -->
        <Color x:Key="Bg0Color">#FF0A0F1C</Color>
        <Color x:Key="Bg1Color">#FF0F172A</Color>
        <SolidColorBrush x:Key="Bg0Brush" Color="#FF0A0F1C" />
        <SolidColorBrush x:Key="Bg1Brush" Color="#FF0F172A" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF16223A" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#FF1B2942" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#FF26344F" />
        <SolidColorBrush x:Key="StrokeSoftBrush" Color="#FF1E2C47" />
        <SolidColorBrush x:Key="RingTrackBrush" Color="#FF1C2B46" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF1F5F9" />
        <SolidColorBrush x:Key="TextDimBrush" Color="#FFA3B1C6" />
        <SolidColorBrush x:Key="TextFaintBrush" Color="#FF7C8CA6" />

        <SolidColorBrush x:Key="SitBrush" Color="#FF3B82F6" />
        <SolidColorBrush x:Key="StandBrush" Color="#FF10B981" />
        <SolidColorBrush x:Key="MoveBrush" Color="#FFF59E0B" />

        <!-- Accent brushes are REPLACED at runtime on every phase change. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF10B981" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#3310B981" />

        <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- ===== Primary / ghost buttons ===== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" BorderThickness="1"
                                BorderBrush="{StaticResource StrokeBrush}"
                                Background="#12A3B1C6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22A3B1C6" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF324A6D" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button: gradient set in code-behind (accent -> darker) on phase change. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="sh" BlurRadius="20" ShadowDepth="6"
                                                  Direction="270" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.94" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small −/+ stepper button -->
        <Style x:Key="StepButton" TargetType="RepeatButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{StaticResource StrokeBrush}"
                                Background="{StaticResource Surface2Brush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#332A4C6E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Memory chip -->
        <Style x:Key="ChipButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="9" BorderThickness="1"
                                BorderBrush="{StaticResource StrokeBrush}"
                                Background="{StaticResource Surface2Brush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF22344F" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF3A557D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <!-- 'armed' state = IsChecked -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle switch -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" CornerRadius="12.5" BorderThickness="1"
                                Background="#FF2A3852" BorderBrush="{StaticResource StrokeBrush}">
                            <Ellipse x:Name="knob" Width="19" Height="19" Fill="#FF8195B3"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="knob" Property="Fill" Value="White" />
                                <Setter TargetName="knob" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="19" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented control button (RadioButton) -->
        <Style x:Key="SegButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="7" Padding="14,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
